def get_letter(data, ch):
    variants = [ch, ch.upper(), ch.lower()]
    if ch.lower() == 'ё':
        variants += ['Ё', 'Е', 'е']
    for v in variants:
        if v in data:
            return data[v]
    raise KeyError(f"Нет буквы {ch!r} в LipsData")
def trim_auto(seq, threshold=0.003, margin=1):
    if seq.shape[0] <= 2:
        return seq
    diff = np.linalg.norm(np.diff(seq, axis=0), axis=(1, 2))
    active = np.where(diff > threshold)[0]
    if len(active) == 0:
        return seq
    start = max(0, active[0] - margin)
    end = min(seq.shape[0], active[-1] + margin + 2)
    return seq[start:end]
def trim_manual(seq, start=0, end=None):
    return seq[start:end]
def combine_and_interpolate(
    word,
    data,
    method='spline',
    trim_config=None,
    auto_trim=False,
    step=0.5
):
    parts = []
    for ch in word:
        seq = get_letter(data, ch)
        if trim_config is not None and ch in trim_config:
            a, b = trim_config[ch]
            seq = trim_manual(seq, a, b)
        elif auto_trim:
            seq = trim_auto(seq)
        parts.append(seq)
    combined = np.concatenate(parts, axis=0)
    if method == 'lagrange':
        return interpolate_letter_lagrange(combined, step=step)
    elif method == 'spline':
        return interpolate_letter_spline(combined, step=step)
    else:
        raise ValueError("method должен быть 'lagrange' или 'spline'")
