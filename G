
de natural_cubic_spline_1d(y, x_nodes, x_new):
    x = np.asarray(x_nodes, dtype=float)
    y = np.asarray(y, dtype=float)
    x_new = np.asarray(x_new, dtype=float)
    n = len(x)
    if n == 2:
        return np.interp(x_new, x, y)
    h = np.diff(x)
    A = np.zeros((n, n), dtype=float)
    rhs = np.zeros(n, dtype=float)
    A[0, 0] = 1.0
    A[-1, -1] = 1.0
    for i in range(1, n - 1):
        A[i, i - 1] = h[i - 1]
        A[i, i] = 2.0 * (h[i - 1] + h[i])
        A[i, i + 1] = h[i]
        rhs[i] = 6.0 * (
            (y[i + 1] - y[i]) / h[i]
            - (y[i] - y[i - 1]) / h[i - 1]
        )
    M = np.linalg.solve(A, rhs)
    out = np.empty_like(x_new, dtype=float)
    idx = np.searchsorted(x, x_new, side='right') - 1
    idx = np.clip(idx, 0, n - 2)
    for k, t in enumerate(x_new):
        i = idx[k]
        dx = t - x[i]
        hi = h[i]
        b = (y[i + 1] - y[i]) / hi - hi * (2.0 * M[i] + M[i + 1]) / 6.0
        c = M[i] / 2.0
        d = (M[i + 1] - M[i]) / (6.0 * hi)
        out[k] = y[i] + b * dx + c * dx**2 + d * dx**3
    return out
def interpolate_letter_spline(seq, step=0.5):
    n = seq.shape[0]
    t_nodes = np.arange(n, dtype=float)
    t_new = np.linspace(0, n - 1, 2 * n - 1)
    out = np.empty((len(t_new), 40, 2), dtype=float)
    for p in range(40):
        for c in range(2):
            out[:, p, c] = natural_cubic_spline_1d(
                seq[:, p, c], t_nodes, t_new
            )
    return out
